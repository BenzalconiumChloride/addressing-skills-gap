[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/BenzalconiumChloride/MTM501-Industry-alignment.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "index"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/index
[branch "new-topic"]
	vscode-merge-base = origin/index
	remote = origin
	merge = refs/heads/new-topic
